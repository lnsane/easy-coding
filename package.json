{
  "name": "easycode",
  "version": "0.4.1",
  "private": true,
  "description": "easyCode - AI 协作与编排桌面应用",
  "author": {
    "name": "lnsane",
    "email": "1137738840@qq.com"
  },
  "homepage": "https://github.com/lnsane/easy-coding",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lnsane/easy-coding.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-markdown-actions.mjs && node scripts/test-creations-db.mjs && node scripts/test-autosave.mjs && node scripts/test-polish-diff.mjs && node scripts/test-git.mjs && node scripts/test-files.mjs && node scripts/test-migrate.mjs && node scripts/test-e2e-flow.mjs && node scripts/test-polish-cwd.mjs && node scripts/test-polish-filemode.mjs",
    "start": "electron-vite preview",
    "pack": "electron-vite build && electron-builder"
  },
  "build": {
    "appId": "com.easycode.app",
    "productName": "easyCode",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "easyCode"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@uiw/react-codemirror": "^4.25.12",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
